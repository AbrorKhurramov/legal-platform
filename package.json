{
  "name": "legal-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start:dev": "vite --mode development --host",
    "build:dev": "npm run typecheck && vite build --mode development",
    "build:prod": "npm run typecheck && vite build --mode production",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "typecheck": "tsc -b",
    "checkup": "npm run typecheck && vitest run && vite build",
    "lint": "oxlint --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "local-agro-ui": "^3.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.104.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  }
}
