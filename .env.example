# Базовый URL бэкенда (src/shared/api/api-instance.ts)
VITE_API_HOST=http://localhost:8080

# Порт дев-сервера
VITE_RUNNING_PORT=3000

# true — смешанный режим: запросы /api/v1/* (вход, файловый менеджер, юридические документы)
# идут в настоящий backend (VITE_API_HOST), остальные модули обслуживает фейковый бэкенд из src/mock.
# false — всё идёт в настоящий backend (когда все модули будут перенесены).
VITE_USE_MOCK=true
